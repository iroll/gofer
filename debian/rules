#!/usr/bin/make -f

# Use the meson buildsystem for the GTK wrapper
%:
	dh $@ --buildsystem=meson --without=dwz

override_dh_auto_configure:
	# Configure the GTK wrapper located in the debian subdir
	dh_auto_configure --sourcedirectory=debian/GoferGTKWrapper

override_dh_auto_build:
	# 1. Build the Go engine directly into the package staging area.
	# This avoids polluting the root folder with a linux binary.
	mkdir -p $(CURDIR)/debian/gofer/usr/bin
	GOTOOLCHAIN=local go build -o $(CURDIR)/debian/gofer/usr/bin/gofer .
	
	# 2. Build the GTK wrapper using its own buildsystem
	dh_auto_build --sourcedirectory=debian/GoferGTKWrapper
         
override_dh_auto_install:
	# 1. The Go binary is already in the right place from the build step.
	
	# 2. Install the Meson-built components (wrapper, desktop files, etc.)
	dh_auto_install --sourcedirectory=debian/GoferGTKWrapper

override_dh_clean:
	# Standard clean-up
	dh_clean
	# Extra insurance: remove any leftover artifacts if they were created
	rm -f gofer

override_dh_dwz:
	# Disable dwz (it often struggles with Go's DWARF format)
	:
